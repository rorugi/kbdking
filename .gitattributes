* text=auto eol=lf

*.cs      text diff=csharp
*.xaml    text
*.csproj  text
*.slnx    text
*.ps1     text eol=crlf

# Layout files are UTF-8 JSON and diff well.
*.keyservant text

# MSKLC sources are UTF-16; let Git treat them as binary unless configured otherwise.
*.klc -text diff

*.dll binary
*.exe binary
*.png binary
*.ico binary
