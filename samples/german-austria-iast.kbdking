  "tests": [
    {"name": "long a", "keys": "AltGr+a", "expect": "ā"},
    {"name": "capital palatal sibilant", "keys": "Shift+AltGr+s", "expect": "Ś"},
    {"name": "dot below", "keys": "AltGr+. t", "expect": "ṭ"},
    {"name": "long vocalic r (chained)", "keys": "AltGr+. AltGr+- r", "expect": "ṝ"},
    {"name": "root sign", "keys": "AltGr+r", "expect": "√"}
  ]
}
