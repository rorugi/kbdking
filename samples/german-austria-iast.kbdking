      "34": "OEM_PERIOD",
      "35": "OEM_MINUS",
      "36": "RSHIFT|EXT",
      "37": "MULTIPLY|MULTIVK",
      "38": "LMENU",
      "39": "SPACE",
      "3A": "CAPITAL",
      "3B": "F1",
      "3C": "F2",
      "3D": "F3",
      "3E": "F4",
      "3F": "F5",
      "40": "F6",
