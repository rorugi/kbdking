        ["u", "ū"],
        ["U", "Ū"],
        [" ", "¯"],
        ["\u0323", "ṝ", "chained"]
      ]
    },
    {
      "accent": "ṝ",
      "name": "DOT BELOW AND MACRON",
      "entries": [["r", "ṝ"], ["R", "Ṝ"], ["l", "ḹ"], ["L", "Ḹ"], [" ", "ṝ"]]
    }
  ],
