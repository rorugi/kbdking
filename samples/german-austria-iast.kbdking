      "53": "DELETE|EXT",
      "5B": "LWIN|EXT",
      "5C": "RWIN|EXT",
      "5D": "APPS|EXT",
      "5F": "SLEEP|EXT",
      "65": "BROWSER_SEARCH|EXT",
      "66": "BROWSER_FAVORITES|EXT",
      "67": "BROWSER_REFRESH|EXT",
      "68": "BROWSER_STOP|EXT",
      "69": "BROWSER_FORWARD|EXT",
      "6A": "BROWSER_BACK|EXT",
      "6B": "LAUNCH_APP1|EXT",
      "6C": "LAUNCH_MAIL|EXT",
      "6D": "LAUNCH_MEDIA_SELECT|EXT"
    },
    "e1": {"1D": "PAUSE"}
  },
  "keys": [
    {"vk": "1", "base": "1", "shift": "!"},
    {"vk": "2", "base": "2", "shift": "\"", "shift+ctrl": "\u0000", "altgr": "²"},
    {"vk": "3", "base": "3", "shift": "§", "altgr": "³"},
    {"vk": "4", "base": "4", "shift": "$"},
    {"vk": "5", "base": "5", "shift": "%"},
    {"vk": "6", "base": "6", "shift": "&", "shift+ctrl": "\u001e"},
    {"vk": "7", "base": "7", "shift": "/", "altgr": "{"},
    {"vk": "8", "base": "8", "shift": "(", "altgr": "["},
    {"vk": "9", "base": "9", "shift": ")", "altgr": "]"},
    {"vk": "0", "base": "0", "shift": "=", "altgr": "}"},
    {"vk": "OEM_4", "base": "ß", "shift": "?", "altgr": "\\"},
    {"vk": "OEM_6", "base": {"dead": "´"}, "shift": {"dead": "`"}},
    {"vk": "Q", "attrs": ["capslock"], "base": "q", "shift": "Q", "altgr": "@"},
    {"vk": "W", "attrs": ["capslock"], "base": "w", "shift": "W"},
    {"vk": "E", "attrs": ["capslock"], "base": "e", "shift": "E", "altgr": "€"},
    {"vk": "R", "attrs": ["capslock"], "base": "r", "shift": "R", "altgr": "√"},
    {"vk": "T", "attrs": ["capslock"], "base": "t", "shift": "T"},
    {"vk": "Z", "attrs": ["capslock"], "base": "z", "shift": "Z"},
    {"vk": "U", "attrs": ["capslock"], "base": "u", "shift": "U", "altgr": "ū", "shift+altgr": "Ū"},
    {"vk": "I", "attrs": ["capslock"], "base": "i", "shift": "I", "altgr": "ī", "shift+altgr": "Ī"},
    {"vk": "O", "attrs": ["capslock"], "base": "o", "shift": "O"},
    {"vk": "P", "attrs": ["capslock"], "base": "p", "shift": "P"},
    {"vk": "OEM_1", "attrs": ["capslock"], "base": "ü", "shift": "Ü", "ctrl": "\u001b"},
    {"vk": "OEM_PLUS", "base": "+", "shift": "*", "ctrl": "\u001d", "altgr": "~"},
    {"vk": "A", "attrs": ["capslock"], "base": "a", "shift": "A", "altgr": "ā", "shift+altgr": "Ā"},
    {"vk": "S", "attrs": ["capslock"], "base": "s", "shift": "S", "altgr": "ś", "shift+altgr": "Ś"},
    {"vk": "D", "attrs": ["capslock"], "base": "d", "shift": "D"},
    {"vk": "F", "attrs": ["capslock"], "base": "f", "shift": "F"},
    {"vk": "G", "attrs": ["capslock"], "base": "g", "shift": "G", "altgr": "ṅ", "shift+altgr": "Ṅ"},
    {"vk": "H", "attrs": ["capslock"], "base": "h", "shift": "H"},
    {"vk": "J", "attrs": ["capslock"], "base": "j", "shift": "J"},
    {"vk": "K", "attrs": ["capslock"], "base": "k", "shift": "K"},
    {"vk": "L", "attrs": ["capslock"], "base": "l", "shift": "L"},
    {"vk": "OEM_3", "attrs": ["capslock"], "base": "ö", "shift": "Ö"},
    {"vk": "OEM_7", "attrs": ["capslock"], "base": "ä", "shift": "Ä"},
    {"vk": "OEM_5", "base": {"dead": "^"}, "shift": "°", "ctrl": "\u001c"},
    {"vk": "OEM_2", "base": "#", "shift": "'", "ctrl": "\u001c"},
    {"vk": "OEM_102", "base": "<", "shift": ">", "ctrl": "\u001c", "altgr": "|"},
    {"vk": "Y", "attrs": ["capslock"], "base": "y", "shift": "Y"},
    {"vk": "X", "attrs": ["capslock"], "base": "x", "shift": "X"},
    {"vk": "C", "attrs": ["capslock"], "base": "c", "shift": "C"},
    {"vk": "V", "attrs": ["capslock"], "base": "v", "shift": "V"},
    {"vk": "B", "attrs": ["capslock"], "base": "b", "shift": "B"},
    {"vk": "N", "attrs": ["capslock"], "base": "n", "shift": "N", "altgr": "ñ", "shift+altgr": "Ñ"},
    {"vk": "M", "attrs": ["capslock"], "base": "m", "shift": "M", "altgr": "µ"},
    {"vk": "OEM_COMMA", "base": ",", "shift": ";"},
    {"vk": "OEM_PERIOD", "base": ".", "shift": ":", "altgr": {"dead": "\u0323"}},
    {"vk": "OEM_MINUS", "base": "-", "shift": "_", "shift+ctrl": "\u001f", "altgr": {"dead": "\u0304"}},
    {"vk": "SPACE", "base": " ", "shift": " ", "ctrl": " "},
    {"vk": "DECIMAL", "base": ",", "shift": ","},
    {"vk": "TAB", "base": "\t", "shift": "\t"},
    {"vk": "ADD", "base": "+", "shift": "+"},
    {"vk": "DIVIDE", "base": "/", "shift": "/"},
    {"vk": "MULTIPLY", "base": "*", "shift": "*"},
    {"vk": "SUBTRACT", "base": "-", "shift": "-"},
    {"vk": "BACK", "base": "\b", "shift": "\b", "ctrl": "\u007f"},
    {"vk": "ESCAPE", "base": "\u001b", "shift": "\u001b", "ctrl": "\u001b"},
    {"vk": "RETURN", "base": "\r", "shift": "\r", "ctrl": "\n"},
    {"vk": "CANCEL", "base": "\u0003", "shift": "\u0003", "ctrl": "\u0003"},
    {"vk": "NUMPAD0", "base": "0"},
    {"vk": "NUMPAD1", "base": "1"},
    {"vk": "NUMPAD2", "base": "2"},
    {"vk": "NUMPAD3", "base": "3"},
    {"vk": "NUMPAD4", "base": "4"},
    {"vk": "NUMPAD5", "base": "5"},
    {"vk": "NUMPAD6", "base": "6"},
    {"vk": "NUMPAD7", "base": "7"},
    {"vk": "NUMPAD8", "base": "8"},
    {"vk": "NUMPAD9", "base": "9"}
  ],
