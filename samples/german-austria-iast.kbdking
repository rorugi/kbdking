      "42": "F8",
      "43": "F9",
      "44": "F10",
      "45": "NUMLOCK|EXT|MULTIVK",
      "46": "SCROLL|MULTIVK",
      "47": "HOME|SPECIAL|NUMPAD",
      "48": "UP|SPECIAL|NUMPAD",
      "49": "PRIOR|SPECIAL|NUMPAD",
      "4A": "SUBTRACT",
      "4B": "LEFT|SPECIAL|NUMPAD",
      "4C": "CLEAR|SPECIAL|NUMPAD",
