<?xml version="1.0" encoding="utf-8"?>
<!--
  Windows installer (MSI) for the kbdking app. Built by tools/build-installer.ps1:
    wix build installer/kbdking.wxs -arch x64 -d PublishDir=<published app> -d Version=0.1.42 -o kbdking-x64.msi
  Installs for all users into Program Files\kbdking, adds a Start menu entry and puts kbdking.exe on the PATH.
  Upgrades replace older versions; uninstall from Settings > Apps. Shows a welcome/licence page and offers to
  start kbdking at the end (needs -ext WixToolset.UI.wixext -ext WixToolset.Util.wixext).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
      Name="kbdking"
      Manufacturer="Roland Russwurm"
      Version="$(var.Version)"
      UpgradeCode="85564B4F-6DA4-4524-A83B-03F85A441A6E"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="kbdking: create, edit and install Windows keyboard layouts" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of kbdking is already installed." AllowSameVersionUpgrades="yes" />
    <!-- Same UpgradeCode as the old "Keyservant" installer, so installing kbdking replaces it. -->
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="kbdking.ico" SourceFile="$(sys.SOURCEFILEDIR)..\src\Kbdking.App\Assets\kbdking.ico" />
    <Property Id="ARPPRODUCTICON" Value="kbdking.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/rorugi/kbdking" />
    <Property Id="ARPCOMMENTS" Value="Create, edit and install Windows keyboard layouts." />

    <!-- Setup screens: welcome + licence, progress, and a finish page that can start the app. -->
    <WixVariable Id="WixUILicenseRtf" Value="$(sys.SOURCEFILEDIR)License.rtf" />
    <WixVariable Id="WixUIDialogBmp" Value="$(sys.SOURCEFILEDIR)dialog.bmp" />
    <WixVariable Id="WixUIBannerBmp" Value="$(sys.SOURCEFILEDIR)banner.bmp" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Start kbdking now" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[INSTALLFOLDER]Kbdking.App.exe" />
    <CustomAction Id="LaunchKbdking" DllEntry="WixShellExec" Impersonate="yes" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" />
    <UI>
      <ui:WixUI Id="WixUI_Minimal" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchKbdking"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
    </UI>

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="kbdking">
        <!-- Everything the app and the CLI publish into one folder. -->
        <Files Include="$(var.PublishDir)\**" />

        <Component Id="CliOnPath" Guid="AF18B5DC-84B3-41A5-B357-41F26D17034E">
          <Environment Id="KbdkingPath" Name="PATH" Value="[INSTALLFOLDER]" Part="last" System="yes" Action="set" Permanent="no" />
          <RegistryValue Root="HKLM" Key="Software\kbdking" Name="InstallFolder" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="22F7D322-39D6-4F3B-B72F-3A2FEFDED7E6">
        <Shortcut Id="KbdkingShortcut" Name="kbdking" Description="Create, edit and install keyboard layouts" Icon="kbdking.ico"
                  Target="[INSTALLFOLDER]Kbdking.App.exe" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKLM" Key="Software\kbdking" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>
  </Package>
</Wix>
