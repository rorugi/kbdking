<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Keyservant.Stub</RootNamespace>
    <AssemblyName>Keyservant.Stub</AssemblyName>
    <Description>Standalone layout installer. Keyservant appends a layout package to a copy of this executable.</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Published as a single native executable that needs no .NET runtime on the target PC. -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <OptimizationPreference>Size</OptimizationPreference>
    <StackTraceSupport>false</StackTraceSupport>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Keyservant.Platform\Keyservant.Platform.csproj" />
  </ItemGroup>

</Project>
