<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Keyservant.App.Views.EditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Keyservant.Presentation"
    xmlns:val="using:Keyservant.Core.Validation"
    xmlns:local="using:Keyservant.App">

    <Grid Padding="24,16" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title and commands -->
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />
            <CommandBar Grid.Column="1" Background="Transparent" DefaultLabelPosition="Right" IsOpen="False">
                <AppBarButton Icon="Add" Label="New">
                    <AppBarButton.Flyout>
                        <MenuFlyout x:Name="NewMenu" />
                    </AppBarButton.Flyout>
                </AppBarButton>
                <AppBarButton Icon="OpenFile" Label="Open" Command="{x:Bind ViewModel.OpenCommand}" />
                <AppBarButton Icon="Save" Label="Save" Command="{x:Bind ViewModel.SaveCommand}" />
                <AppBarButton Icon="Download" Label="Install" Command="{x:Bind ViewModel.InstallCommand}" />
                <CommandBar.SecondaryCommands>
                    <AppBarButton Icon="SaveLocal" Label="Save as…" Command="{x:Bind ViewModel.SaveAsCommand}" />
                    <AppBarButton Icon="Share" Label="Export .klc / .c…" Command="{x:Bind ViewModel.ExportCommand}" />
                    <AppBarButton Icon="Setting" Label="Build DLLs…" Command="{x:Bind ViewModel.BuildCommand}" />
                    <AppBarButton Icon="Send" Label="Create installer…" Command="{x:Bind ViewModel.PackageCommand}" />
                </CommandBar.SecondaryCommands>
            </CommandBar>
        </Grid>

        <Pivot Grid.Row="1">
            <!-- Keys -->
            <PivotItem Header="Keys">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16" Padding="0,8,0,24">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <ComboBox
                                Header="Shift state"
                                MinWidth="200"
                                DisplayMemberPath="Label"
                                ItemsSource="{x:Bind ViewModel.ShiftStates}"
                                SelectedItem="{Binding SelectedState, Mode=TwoWay}" />
                            <ToggleSwitch
                                Header="Keyboard"
                                IsOn="{x:Bind ViewModel.IsIso, Mode=TwoWay}"
                                OffContent="ANSI (US)"
                                OnContent="ISO (Europe)" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{x:Bind ViewModel.KeyboardRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:KeyboardRowViewModel">
                                    <ItemsControl ItemsSource="{x:Bind Keys}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:KeyCapViewModel">
                                                <Button
                                                    Width="{x:Bind Width}"
                                                    Height="52"
                                                    Margin="2"
                                                    Padding="4,2"
                                                    HorizontalContentAlignment="Stretch"
                                                    VerticalContentAlignment="Stretch"
                                                    Background="{x:Bind local:Converters.KeyBackground(IsSelected, IsDead, IsCharacterKey), Mode=OneWay}"
                                                    Command="{x:Bind SelectCommand}"
                                                    ToolTipService.ToolTip="{x:Bind ToolTip, Mode=OneWay}">
                                                    <Grid>
                                                        <TextBlock
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Top"
                                                            FontSize="11"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Text="{x:Bind ShiftLabel, Mode=OneWay}" />
                                                        <TextBlock
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            FontSize="17"
                                                            Text="{x:Bind Label, Mode=OneWay}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Selected key -->
                        <StackPanel
                            Padding="16"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8"
                            Spacing="8"
                            Visibility="{x:Bind local:Converters.Visible(ViewModel.KeyEditor), Mode=OneWay}">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}">
                                <Run Text="Key " />
                                <Run Text="{x:Bind ViewModel.KeyEditor.Title, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Type characters, or codes like U+0101. Leave empty for nothing. A dead key waits for the next keystroke (see the Dead keys tab)." />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.KeyEditor.Rows, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:OutputRowViewModel">
                                        <Grid Margin="0,4" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="180" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center" Text="{x:Bind StateName}" />
                                            <TextBox Grid.Column="1" FontSize="16" Text="{x:Bind Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <CheckBox Grid.Column="2" Content="Dead key" IsChecked="{x:Bind IsDead, Mode=TwoWay}" />
                                            <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                <TextBlock
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind CodePoints, Mode=OneWay}" />
                                                <TextBlock
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                    Text="{x:Bind Error, Mode=OneWay}"
                                                    Visibility="{x:Bind local:Converters.VisibleIfText(Error), Mode=OneWay}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" Spacing="24">
                                <CheckBox Content="Caps Lock acts like Shift" IsChecked="{x:Bind ViewModel.KeyEditor.CapsLock, Mode=TwoWay}" />
                                <CheckBox Content="…also with AltGr" IsChecked="{x:Bind ViewModel.KeyEditor.CapsLockAltGr, Mode=TwoWay}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Live preview -->
                        <StackPanel Spacing="4">
                            <TextBox
                                x:Name="Preview"
                                MinHeight="72"
                                AcceptsReturn="True"
                                Header="Try it: click here and type. Keystrokes use the layout you are editing, not the active Windows layout."
                                IsReadOnly="True"
                                PreviewKeyDown="Preview_PreviewKeyDown"
                                Text="{x:Bind ViewModel.PreviewText, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <Button Content="Clear" Command="{x:Bind ViewModel.ClearPreviewCommand}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <!-- Dead keys -->
            <PivotItem Header="Dead keys">
                <Grid ColumnSpacing="24" Padding="0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ListView
                            ItemsSource="{x:Bind ViewModel.DeadKeys.DeadKeys}"
                            SelectedItem="{Binding DeadKeys.Selected, Mode=TwoWay}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:DeadKeyViewModel">
                                    <Grid Padding="0,6" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontSize="22" VerticalAlignment="Center" Text="{x:Bind Accent}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{x:Bind Name, Mode=OneWay}" />
                                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                <Run Text="{x:Bind AccentCode}" />
                                                <Run Text=" · " />
                                                <Run Text="{x:Bind Count, Mode=OneWay}" />
                                                <Run Text=" compositions" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                            <TextBox Width="160" PlaceholderText="Accent, e.g. U+0323" Text="{x:Bind ViewModel.DeadKeys.NewAccent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Content="Add dead key" Command="{x:Bind ViewModel.DeadKeys.AddDeadKeyCommand}" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Column="1" RowSpacing="8" Visibility="{x:Bind local:Converters.Visible(ViewModel.DeadKeys.Selected), Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox Header="Name shown by Windows" MaxWidth="360" HorizontalAlignment="Left" Text="{x:Bind ViewModel.DeadKeys.Selected.Name, Mode=TwoWay}" />
                        <TextBlock
                            Grid.Row="1"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Dead key + base → result. 'Chained' makes the result a dead key too (e.g. dot below, then macron → ṝ)." />
                        <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.DeadKeys.Selected.Entries, Mode=OneWay}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:DeadKeyEntryViewModel">
                                    <StackPanel Orientation="Horizontal" Spacing="12" Padding="0,4">
                                        <TextBox Width="120" Header="Base" Text="{x:Bind Base, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Width="120" Header="Result" Text="{x:Bind Result, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <CheckBox VerticalAlignment="Bottom" Content="Chained" IsChecked="{x:Bind Chained, Mode=TwoWay}" />
                                        <Button VerticalAlignment="Bottom" Command="{x:Bind RemoveCommand}" ToolTipService.ToolTip="Remove">
                                            <SymbolIcon Symbol="Delete" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Button Grid.Row="3" Content="Add composition" Command="{x:Bind ViewModel.DeadKeys.Selected.AddEntryCommand, Mode=OneWay}" />
                    </Grid>
                </Grid>
            </PivotItem>

            <!-- Layout metadata -->
            <PivotItem Header="Layout">
                <ScrollViewer>
                    <StackPanel MaxWidth="560" HorizontalAlignment="Left" Padding="0,8,0,24" Spacing="12">
                        <TextBox Header="Name" Text="{x:Bind ViewModel.LayoutName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Header="DLL name (1–8 letters or digits, e.g. kbdiast)" Text="{x:Bind ViewModel.DllName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Header="Language (e.g. de-AT)" Text="{x:Bind ViewModel.Locale, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Header="Version" Text="{x:Bind ViewModel.LayoutVersion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Header="Author" Text="{x:Bind ViewModel.Author, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Header="Description" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" Text="{x:Bind ViewModel.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <CheckBox Content="Right Alt acts as AltGr" IsChecked="{x:Bind ViewModel.AltGrFlag, Mode=TwoWay}" />
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                            <Run Text="Layout ID: " />
                            <Run Text="{x:Bind ViewModel.LayoutId, Mode=OneWay, TargetNullValue='assigned on first install'}" />
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <!-- Problems -->
            <PivotItem Header="Problems">
                <Grid RowSpacing="8" Padding="0,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.IssueSummary, Mode=OneWay}" />
                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Issues}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="val:ValidationIssue">
                                <Grid Padding="0,6" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        VerticalAlignment="Top"
                                        Glyph="{x:Bind local:Converters.SeverityGlyph(Severity)}"
                                        Foreground="{x:Bind local:Converters.SeverityBrush(Severity)}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{x:Bind Message}" TextWrapping="Wrap" />
                                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Code}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>
        </Pivot>

        <TextBlock
            Grid.Row="2"
            Style="{StaticResource CaptionTextBlockStyle}"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="{x:Bind ViewModel.Status, Mode=OneWay}"
            TextWrapping="Wrap" />
    </Grid>
</UserControl>
