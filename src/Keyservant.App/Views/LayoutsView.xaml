<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Keyservant.App.Views.LayoutsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Keyservant.Presentation"
    xmlns:local="using:Keyservant.App">

    <Grid Padding="32,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Text="Keyboard layouts" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Switch a layout on to add it to the Win+Space switcher. Windows layouts are only switched off, never deleted; custom layouts can be uninstalled completely." />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="420" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                PlaceholderText="Search by name or layout ID"
                Text="{x:Bind ViewModel.Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <CheckBox
                Grid.Column="1"
                Content="Custom only"
                IsChecked="{x:Bind ViewModel.CustomOnly, Mode=TwoWay}" />
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
                <Button Command="{x:Bind ViewModel.RefreshCommand}" ToolTipService.ToolTip="Refresh">
                    <SymbolIcon Symbol="Refresh" />
                </Button>
                <Button Content="Install from file…" Command="{x:Bind ViewModel.InstallFromFileCommand}" Style="{StaticResource AccentButtonStyle}" />
                <Button Content="Repair" Command="{x:Bind ViewModel.RepairCommand}" ToolTipService.ToolTip="Restore custom layouts that a Windows update removed" />
            </StackPanel>
        </Grid>

        <ListView
            Grid.Row="2"
            ItemsSource="{x:Bind ViewModel.Layouts}"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:LayoutItemViewModel">
                    <Grid Padding="0,8" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ToggleSwitch
                            MinWidth="0"
                            VerticalAlignment="Center"
                            IsOn="{x:Bind IsEnabled, Mode=TwoWay}"
                            OffContent=""
                            OnContent="" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                <Run Text="{x:Bind Kind}" />
                                <Run Text=" · " />
                                <Run Text="{x:Bind Klid}" />
                                <Run Text=" · " />
                                <Run Text="{x:Bind LayoutFile}" />
                            </TextBlock>
                            <TextBlock
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Text="{x:Bind Problem}"
                                Visibility="{x:Bind local:Converters.VisibleIf(HasProblem)}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Content="Edit a copy" Command="{x:Bind EditCopyCommand}" />
                            <Button
                                Content="Uninstall"
                                Command="{x:Bind UninstallCommand}"
                                Visibility="{x:Bind local:Converters.VisibleIf(IsCustom)}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock
            Grid.Row="3"
            Style="{StaticResource CaptionTextBlockStyle}"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="{x:Bind ViewModel.Status, Mode=OneWay}" />
    </Grid>
</UserControl>
