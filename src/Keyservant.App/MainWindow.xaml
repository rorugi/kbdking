<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Keyservant.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Keyservant">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <NavigationView
        x:Name="Nav"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        PaneDisplayMode="Left"
        OpenPaneLength="200"
        SelectionChanged="Nav_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem x:Name="LayoutsItem" Content="Layouts" Tag="layouts" Icon="Keyboard" />
            <NavigationViewItem x:Name="EditorItem" Content="Editor" Tag="editor" Icon="Edit" />
        </NavigationView.MenuItems>
        <NavigationView.FooterMenuItems>
            <NavigationViewItem Content="About" Tag="about" Icon="Help" />
        </NavigationView.FooterMenuItems>
        <ContentControl
            x:Name="Host"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch" />
    </NavigationView>
</Window>
