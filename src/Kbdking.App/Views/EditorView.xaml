<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Kbdking.App.Views.EditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Kbdking.Presentation"
    xmlns:val="using:Kbdking.Core.Validation"
    xmlns:uni="using:Kbdking.Core.Unicode"
    xmlns:diff="using:Kbdking.Core.Diff"
    xmlns:local="using:Kbdking.App"
    xmlns:views="using:Kbdking.App.Views">

    <UserControl.Resources>
        <!-- Used by the Unicode picker flyout, which is built in code-behind. -->
        <DataTemplate x:Key="UnicodeItemTemplate" x:DataType="uni:UnicodeCharInfo">
            <Grid ColumnSpacing="12" Padding="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock FontSize="20" VerticalAlignment="Center" Text="{x:Bind Display}" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Code}" />
                <TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Padding="24,16" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title and commands -->
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind ViewModel.Title, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
            <CommandBar Grid.Column="1" Background="Transparent" DefaultLabelPosition="Right" IsOpen="False">
                <AppBarButton Icon="Undo" Label="Undo" Command="{x:Bind ViewModel.UndoCommand}" ToolTipService.ToolTip="Undo (Ctrl+Z)">
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="Z" />
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarButton Icon="Redo" Label="Redo" Command="{x:Bind ViewModel.RedoCommand}" ToolTipService.ToolTip="Redo (Ctrl+Y)">
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="Y" />
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarSeparator />
                <AppBarButton Icon="Add" Label="New">
                    <AppBarButton.Flyout>
                        <MenuFlyout x:Name="NewMenu" />
                    </AppBarButton.Flyout>
                </AppBarButton>
                <AppBarButton Icon="OpenFile" Label="Open" Command="{x:Bind ViewModel.OpenCommand}" />
                <AppBarButton Icon="Save" Label="Save" Command="{x:Bind ViewModel.SaveCommand}" />
                <AppBarButton Icon="Download" Label="Install" Command="{x:Bind ViewModel.InstallCommand}" />
                <AppBarButton Icon="Clock" Label="Try" ToolTipService.ToolTip="Install for a limited time; Windows removes it again automatically">
                    <AppBarButton.Flyout>
                        <Flyout>
                            <StackPanel Width="300" Spacing="12">
                                <TextBlock TextWrapping="Wrap" Text="Installs the layout for a while so you can try it in real apps. It is removed automatically, even if kbdking is closed. Keep it from the Layouts page." />
                                <NumberBox
                                    Header="Minutes"
                                    Minimum="1"
                                    Maximum="10080"
                                    SpinButtonPlacementMode="Inline"
                                    Value="{x:Bind ViewModel.TestMinutesValue, Mode=TwoWay}" />
                                <Button Content="Test install" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.TestInstallCommand}" />
                            </StackPanel>
                        </Flyout>
                    </AppBarButton.Flyout>
                </AppBarButton>
                <CommandBar.SecondaryCommands>
                    <AppBarButton Icon="SaveLocal" Label="Save as…" Command="{x:Bind ViewModel.SaveAsCommand}" />
                    <AppBarButton Icon="Share" Label="Export (.klc, macOS, Linux, .c)…" Command="{x:Bind ViewModel.ExportCommand}" />
                    <AppBarButton Icon="Pictures" Label="Save keyboard picture…" Command="{x:Bind ViewModel.ExportPictureCommand}" />
                    <AppBarButton Icon="Print" Label="Print key stickers…" Command="{x:Bind ViewModel.ExportStickersCommand}" />
                    <AppBarSeparator />
                    <AppBarButton Icon="Setting" Label="Build DLLs…" Command="{x:Bind ViewModel.BuildCommand}" />
                    <AppBarButton Icon="Send" Label="Create installer…" Command="{x:Bind ViewModel.PackageCommand}" />
                </CommandBar.SecondaryCommands>
            </CommandBar>
        </Grid>

        <Grid Grid.Row="1" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
            <SelectorBar x:Name="EditorTabs" SelectionChanged="EditorTabs_SelectionChanged">
                <SelectorBarItem Text="Keys" Tag="tab-keys" IsSelected="True" />
                <SelectorBarItem Text="Dead keys" Tag="tab-deadkeys" />
                <SelectorBarItem Text="Compose" Tag="tab-compose" />
                <SelectorBarItem Text="Assistant" Tag="tab-assistant" />
                <SelectorBarItem Text="Analysis" Tag="tab-analysis" />
                <SelectorBarItem Text="Tests" Tag="tab-tests" />
                <SelectorBarItem Text="Compare" Tag="tab-compare" />
                <SelectorBarItem Text="Advanced" Tag="advanced" />
                <SelectorBarItem Text="Layout" Tag="tab-layout" />
                <SelectorBarItem Text="Problems" Tag="tab-problems" />
            </SelectorBar>
                <views:InfoButton x:Name="TabInfo" Grid.Column="1" HorizontalAlignment="Left" Topic="tab-keys" ToolTipService.ToolTip="About this tab" />
            </Grid>
            <Grid x:Name="EditorPages" Grid.Row="1">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16" Padding="0,8,0,24">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <ComboBox
                                Header="Shift state"
                                MinWidth="200"
                                DisplayMemberPath="Label"
                                ItemsSource="{x:Bind ViewModel.ShiftStateChoices}"
                                SelectedItem="{Binding SelectedState, Mode=TwoWay}" />
                            <views:InfoButton VerticalAlignment="Bottom" Topic="shift-state" />
                            <TextBlock
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,6"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.AutoStateText, Mode=OneWay}"
                                Visibility="{x:Bind local:Converters.VisibleIfText(ViewModel.AutoStateText), Mode=OneWay}" />
                            <ComboBox
                                Header="Keyboard"
                                MinWidth="200"
                                DisplayMemberPath="Label"
                                ItemsSource="{x:Bind ViewModel.Shapes}"
                                SelectedItem="{Binding SelectedShape, Mode=TwoWay}" />
                            <views:InfoButton VerticalAlignment="Bottom" Topic="keyboard-shape" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{x:Bind ViewModel.KeyboardRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:KeyboardRowViewModel">
                                    <ItemsControl ItemsSource="{x:Bind Keys}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:KeyCapViewModel">
                                                <Button
                                                    Width="{x:Bind Width}"
                                                    Height="52"
                                                    Margin="2"
                                                    Padding="4,2"
                                                    HorizontalContentAlignment="Stretch"
                                                    VerticalContentAlignment="Stretch"
                                                    Background="{x:Bind local:Converters.KeyBackground(IsSelected, IsDead, IsCharacterKey, IsHighlighted, IsHomeKey), Mode=OneWay}"
                                                    Command="{x:Bind SelectCommand}"
                                                    ToolTipService.ToolTip="{x:Bind ToolTip, Mode=OneWay}">
                                                    <Grid>
                                                        <TextBlock
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Top"
                                                            FontSize="11"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Text="{x:Bind CornerLabel, Mode=OneWay}" />
                                                        <TextBlock
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            FontSize="17"
                                                            Text="{x:Bind Label, Mode=OneWay}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Selected key -->
                        <StackPanel
                            Padding="16"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8"
                            Spacing="8"
                            Visibility="{x:Bind local:Converters.Visible(ViewModel.KeyEditor), Mode=OneWay}">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}">
                                <Run Text="Key " />
                                <Run Text="{x:Bind ViewModel.KeyEditor.Title, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.KeyEditor.Details, Mode=OneWay}" />
                            <Grid ColumnSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Type characters, or codes like U+0101. Leave empty for nothing. A dead key waits for the next keystroke (see the Dead keys tab)." />
                                <views:InfoButton Grid.Column="1" VerticalAlignment="Bottom" Topic="key-editor" />
                            </Grid>
                            <ItemsControl ItemsSource="{x:Bind ViewModel.KeyEditor.Rows, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:OutputRowViewModel">
                                        <Grid Margin="0,4" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="180" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center" Text="{x:Bind StateName}" />
                                            <TextBox Grid.Column="1" FontSize="16" Text="{x:Bind Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Grid.Column="2" Click="PickCharacter_Click" ToolTipService.ToolTip="Find a character by name">
                                                <FontIcon Glyph="&#xE721;" FontSize="14" />
                                            </Button>
                                            <CheckBox Grid.Column="3" Content="Dead key" IsChecked="{x:Bind IsDead, Mode=TwoWay}" />
                                            <HyperlinkButton
                                                Grid.Column="4"
                                                Padding="4,2"
                                                Content="Edit dead key ›"
                                                Command="{x:Bind ShowDeadKeyCommand}"
                                                ToolTipService.ToolTip="Show this dead key and its compositions on the Dead keys tab"
                                                Visibility="{x:Bind local:Converters.VisibleIf(HasDeadKey), Mode=OneWay}" />
                                            <StackPanel Grid.Column="5" VerticalAlignment="Center">
                                                <TextBlock
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind CodePoints, Mode=OneWay}" />
                                                <TextBlock
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                    Text="{x:Bind Error, Mode=OneWay}"
                                                    Visibility="{x:Bind local:Converters.VisibleIfText(Error), Mode=OneWay}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" Spacing="24">
                                <CheckBox Content="Caps Lock acts like Shift" IsChecked="{x:Bind ViewModel.KeyEditor.CapsLock, Mode=TwoWay}" />
                                <CheckBox Content="…also with AltGr" IsChecked="{x:Bind ViewModel.KeyEditor.CapsLockAltGr, Mode=TwoWay}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Live preview -->
                        <StackPanel Spacing="4">
                            <TextBox
                                x:Name="Preview"
                                MinHeight="72"
                                AcceptsReturn="True"
                                Header="Try it: click here and type. Keystrokes use the layout you are editing, not the active Windows layout."
                                IsSpellCheckEnabled="False"
                                IsTextPredictionEnabled="False"
                                BeforeTextChanging="Preview_BeforeTextChanging"
                                TextChanged="Preview_TextChanged"
                                PreviewKeyDown="Preview_PreviewKeyDown"
                                PreviewKeyUp="Preview_PreviewKeyUp"
                                LostFocus="Preview_LostFocus"
                                Text="{x:Bind ViewModel.PreviewText, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Clear" Command="{x:Bind ViewModel.ClearPreviewCommand}" />
                                <views:InfoButton Topic="preview" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            <Grid Visibility="Collapsed">
                <Grid ColumnSpacing="24" Padding="0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ListView
                            x:Name="DeadKeyList"
                            ItemsSource="{x:Bind ViewModel.DeadKeys.DeadKeys}"
                            SelectedItem="{Binding DeadKeys.Selected, Mode=TwoWay}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:DeadKeyViewModel">
                                    <Grid Padding="0,6" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontSize="22" VerticalAlignment="Center" Text="{x:Bind Accent}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{x:Bind Name, Mode=OneWay}" />
                                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                <Run Text="{x:Bind AccentCode}" />
                                                <Run Text=" · " />
                                                <Run Text="{x:Bind Count, Mode=OneWay}" />
                                                <Run Text=" compositions" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel Grid.Row="1" Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBox Width="160" PlaceholderText="Accent, e.g. U+0323" Text="{x:Bind ViewModel.DeadKeys.NewAccent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Content="Add" Command="{x:Bind ViewModel.DeadKeys.AddDeadKeyCommand}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <DropDownButton Content="Add with compositions">
                                    <DropDownButton.Flyout>
                                        <MenuFlyout x:Name="CommonDeadKeysMenu" Placement="Bottom" />
                                    </DropDownButton.Flyout>
                                </DropDownButton>
                                <Button Content="Remove" Command="{x:Bind ViewModel.DeadKeys.RemoveDeadKeyCommand}" ToolTipService.ToolTip="Removes the dead key and every key that types it" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Column="1" RowSpacing="8" Visibility="{x:Bind local:Converters.Visible(ViewModel.DeadKeys.Selected), Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox Header="Name shown by Windows" MaxWidth="360" HorizontalAlignment="Left" Text="{x:Bind ViewModel.DeadKeys.Selected.Name, Mode=TwoWay}" />
                        <TextBlock
                            Grid.Row="1"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Dead key + base → result. 'Chained' makes the result a dead key too (e.g. dot below, then macron → ṝ)." />
                        <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.DeadKeys.Selected.Entries, Mode=OneWay}" SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.Header>
                                <StackPanel Orientation="Horizontal" Spacing="12" Margin="16,0,0,4">
                                    <TextBlock Width="120" Style="{StaticResource CaptionTextBlockStyle}" Text="Base" />
                                    <TextBlock Width="120" Style="{StaticResource CaptionTextBlockStyle}" Text="Result" />
                                </StackPanel>
                            </ListView.Header>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:DeadKeyEntryViewModel">
                                    <!-- The remove button comes before the character name, which is trimmed, so it is always visible. -->
                                    <Grid Padding="0,4" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox PlaceholderText="Base" Text="{x:Bind Base, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Grid.Column="1" PlaceholderText="Result" Text="{x:Bind Result, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Grid.Column="2" VerticalAlignment="Center" Click="PickCharacter_Click" ToolTipService.ToolTip="Find a character by name">
                                            <FontIcon Glyph="&#xE721;" FontSize="14" />
                                        </Button>
                                        <CheckBox Grid.Column="3" MinWidth="0" VerticalAlignment="Center" Content="Chained" IsChecked="{x:Bind Chained, Mode=TwoWay}" />
                                        <Button Grid.Column="4" VerticalAlignment="Center" Command="{x:Bind RemoveCommand}" ToolTipService.ToolTip="Remove">
                                            <SymbolIcon Symbol="Delete" />
                                        </Button>
                                        <TextBlock
                                            Grid.Column="5"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind ResultName, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap"
                                            ToolTipService.ToolTip="{x:Bind ResultName, Mode=OneWay}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Button Grid.Row="3" Content="Add composition" Command="{x:Bind ViewModel.DeadKeys.Selected.AddEntryCommand, Mode=OneWay}" />
                    </Grid>
                </Grid>
            </Grid>
            <Grid Visibility="Collapsed">
                <Grid RowSpacing="12" Padding="0,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="8">
                        <TextBlock
                            Style="{StaticResource BodyTextBlockStyle}"
                            TextWrapping="Wrap"
                            Text="Press the compose key, then a short sequence: Compose . r → ṛ, Compose - - → –. kbdking turns the sequences into dead keys inside the layout, so they work in every app without extra software." />
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <ToggleSwitch Header="Compose key" IsOn="{x:Bind ViewModel.Compose.IsEnabled, Mode=TwoWay}" OnContent="On" OffContent="Off" />
                            <ComboBox
                                Header="Key"
                                MinWidth="220"
                                DisplayMemberPath="Label"
                                IsEnabled="{x:Bind ViewModel.Compose.IsEnabled, Mode=OneWay}"
                                ItemsSource="{x:Bind ViewModel.Compose.KeyOptions}"
                                SelectedItem="{Binding Compose.SelectedKey, Mode=TwoWay}" />
                            <views:InfoButton VerticalAlignment="Bottom" Topic="compose-key" />
                            <TextBox Header="Shown while waiting" Width="140" IsEnabled="{x:Bind ViewModel.Compose.IsEnabled, Mode=OneWay}" Text="{x:Bind ViewModel.Compose.Accent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <views:InfoButton VerticalAlignment="Bottom" Topic="compose-accent" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.Compose.Summary, Mode=OneWay}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                        <Button Content="Add sequence" Command="{x:Bind ViewModel.Compose.AddCommand}" />
                        <Button Content="Import .XCompose / WinCompose…" Command="{x:Bind ViewModel.Compose.ImportCommand}" />
                        <Button Content="Export .XCompose…" Command="{x:Bind ViewModel.Compose.ExportCommand}" />
                        <TextBox Width="220" PlaceholderText="Filter" Text="{x:Bind ViewModel.Compose.Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <Grid Grid.Row="2" ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="360" />
                        </Grid.ColumnDefinitions>
                        <ListView ItemsSource="{x:Bind ViewModel.Compose.Sequences}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:ComposeSequenceViewModel">
                                    <StackPanel Orientation="Horizontal" Spacing="12" Padding="0,4">
                                        <TextBox Width="120" PlaceholderText="Keys" Text="{x:Bind Keys, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock VerticalAlignment="Center" Text="→" />
                                        <TextBox Width="100" PlaceholderText="Result" Text="{x:Bind Result, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Click="PickCharacter_Click" ToolTipService.ToolTip="Find a character by name">
                                            <FontIcon Glyph="&#xE721;" FontSize="14" />
                                        </Button>
                                        <Button Command="{x:Bind RemoveCommand}" ToolTipService.ToolTip="Remove">
                                            <SymbolIcon Symbol="Delete" />
                                        </Button>
                                        <TextBlock VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ResultName, Mode=OneWay}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <ListView Grid.Column="1" Header="Warnings" ItemsSource="{x:Bind ViewModel.Compose.Warnings}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>
            </Grid>
            <Grid Visibility="Collapsed">
                <ScrollViewer>
                    <StackPanel Spacing="12" Padding="0,8,0,24">
                        <TextBlock
                            Style="{StaticResource BodyTextBlockStyle}"
                            TextWrapping="Wrap"
                            Text="Start from the characters you need. kbdking proposes dead keys for shared accents and look-alike keys for the rest, and keeps what you have." />
                        <DropDownButton Content="Start from a character set">
                            <DropDownButton.Flyout>
                                <MenuFlyout x:Name="PresetMenu" Placement="Bottom" />
                            </DropDownButton.Flyout>
                        </DropDownButton>
                        <TextBox
                            Header="Characters"
                            TextWrapping="Wrap"
                            AcceptsReturn="True"
                            MinHeight="64"
                            Text="{x:Bind ViewModel.Assistant.Characters, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox
                            Header="Sample text (optional; frequent characters get the easiest keys)"
                            TextWrapping="Wrap"
                            AcceptsReturn="True"
                            MinHeight="64"
                            MaxHeight="200"
                            Text="{x:Bind ViewModel.Assistant.SampleText, Mode=TwoWay}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <NumberBox
                                Width="260"
                                Header="Characters needed for an own dead key"
                                Minimum="1"
                                Maximum="50"
                                SpinButtonPlacementMode="Inline"
                                Value="{x:Bind ViewModel.Assistant.DeadKeyThresholdValue, Mode=TwoWay}" />
                            <views:InfoButton VerticalAlignment="Bottom" Topic="assistant-threshold" />
                            <Button Margin="16,0,0,0" VerticalAlignment="Bottom" Content="Suggest" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.Assistant.SuggestCommand}" />
                            <Button VerticalAlignment="Bottom" Content="Apply selected" Command="{x:Bind ViewModel.Assistant.ApplyCommand}" />
                        </StackPanel>

                        <!-- Results -->
                        <TextBlock Margin="0,8,0,0" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.Assistant.Summary, Mode=OneWay}" TextWrapping="Wrap" />
                        <TextBlock
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.Assistant.AlreadyTypeable, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind local:Converters.VisibleIfText(ViewModel.Assistant.AlreadyTypeable), Mode=OneWay}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Assistant.Proposals}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ProposalViewModel">
                                    <Grid Padding="12,8" Margin="0,0,0,4" ColumnSpacing="12" CornerRadius="6" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox MinWidth="0" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap" />
                                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                <Run Text="{x:Bind Kind}" />
                                                <Run Text=" · " />
                                                <Run Text="{x:Bind Characters}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Assistant.NotPlaced}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemFillColorCautionBrush}" Text="{x:Bind}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            <Grid Visibility="Collapsed">
                <ScrollViewer>
                    <StackPanel Spacing="12" Padding="0,8,0,24">
                        <TextBlock
                            Style="{StaticResource BodyTextBlockStyle}"
                            TextWrapping="Wrap"
                            Text="Paste a text you type often. kbdking counts the keystrokes and modifiers each character needs with this layout, shows a heatmap and lists what is slow or impossible to type." />
                        <TextBox AcceptsReturn="True" TextWrapping="Wrap" MinHeight="96" MaxHeight="200" PlaceholderText="Paste text here" Text="{x:Bind ViewModel.Analysis.Text, Mode=TwoWay}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Analyze" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.Analysis.AnalyzeCommand}" />
                            <Button Content="Load text file…" Command="{x:Bind ViewModel.Analysis.LoadTextCommand}" />
                            <Button Content="Compare with another layout…" Command="{x:Bind ViewModel.Analysis.CompareCommand}" />
                            <Button Content="Save heatmap…" Command="{x:Bind ViewModel.Analysis.SaveHeatmapCommand}" />
                            <Button Content="Place missing characters" Click="SendToAssistant_Click" ToolTipService.ToolTip="Opens the assistant with the untypeable characters" />
                            <views:InfoButton Topic="analysis-effort" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.Analysis.Summary, Mode=OneWay}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.Analysis.Comparison, Mode=OneWay}" TextWrapping="Wrap" Visibility="{x:Bind local:Converters.VisibleIfText(ViewModel.Analysis.Comparison), Mode=OneWay}" />
                        <Image x:Name="HeatmapImage" MaxWidth="1100" HorizontalAlignment="Left" Stretch="Uniform" />
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Most effort" />
                                <ItemsControl ItemsSource="{x:Bind ViewModel.Analysis.Expensive}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CharacterRow">
                                            <Grid ColumnSpacing="12" Padding="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="32" />
                                                    <ColumnDefinition Width="64" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="48" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock FontSize="18" Text="{x:Bind Character}" />
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind CountText}" />
                                                <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{x:Bind Keys}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="{x:Bind Effort}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Not typeable" />
                                <ItemsControl ItemsSource="{x:Bind ViewModel.Analysis.Untypeable}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CharacterRow">
                                            <Grid ColumnSpacing="12" Padding="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="32" />
                                                    <ColumnDefinition Width="64" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock FontSize="18" Text="{x:Bind Character}" />
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind CountText}" />
                                                <TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            <Grid Visibility="Collapsed">
                <Grid RowSpacing="8" Padding="0,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock
                            Style="{StaticResource BodyTextBlockStyle}"
                            TextWrapping="Wrap"
                            Text="Tests say which keys must type which text, e.g. 'AltGr+. t' → ṭ or 'Compose . r' → ṛ. They are saved with the layout and checked after every change; a failing test blocks building." />
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.Tests.Summary, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                        <Button Content="Add test" Command="{x:Bind ViewModel.Tests.AddCommand}" />
                        <Button Content="Add tests for what the layout types now" Command="{x:Bind ViewModel.Tests.AddDefaultsCommand}" />
                    </StackPanel>
                    <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.Tests.Tests}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:TestCaseViewModel">
                                <StackPanel Orientation="Horizontal" Spacing="12" Padding="0,4">
                                    <TextBlock Width="20" VerticalAlignment="Center" FontSize="16" Text="{x:Bind StatusGlyph, Mode=OneWay}" Foreground="{x:Bind local:Converters.TestBrush(Passed), Mode=OneWay}" />
                                    <TextBox Width="200" PlaceholderText="Keys, e.g. AltGr+. t" Text="{x:Bind Keys, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Width="100" PlaceholderText="Expected" Text="{x:Bind Expect, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Width="180" PlaceholderText="Name (optional)" Text="{x:Bind Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Command="{x:Bind RemoveCommand}" ToolTipService.ToolTip="Remove">
                                        <SymbolIcon Symbol="Delete" />
                                    </Button>
                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Message, Mode=OneWay}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>
            <Grid Visibility="Collapsed">
                <Grid RowSpacing="8" Padding="0,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Compare with a file…" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.Compare.CompareWithFileCommand}" />
                        <Button Content="Compare with saved version" Command="{x:Bind ViewModel.Compare.CompareWithSavedCommand}" />
                        <Button Content="Clear" Command="{x:Bind ViewModel.Compare.ClearCommand}" />
                        <CheckBox Content="Mark changed keys on the Keys tab" IsChecked="{x:Bind ViewModel.Compare.HighlightOnKeyboard, Mode=TwoWay}" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.Compare.Summary, Mode=OneWay}" TextWrapping="Wrap" />
                    <Image x:Name="DiffImage" Grid.Row="2" MaxWidth="1100" MaxHeight="360" HorizontalAlignment="Left" Stretch="Uniform" />
                    <ListView Grid.Row="3" ItemsSource="{x:Bind ViewModel.Compare.Changes}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="diff:LayoutChange">
                                <Grid ColumnSpacing="12" Padding="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Kind}" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Area}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Item}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Text="{x:Bind Before}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="4" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Text="{x:Bind After}" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>
            <Grid Visibility="Collapsed">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                    <SelectorBar x:Name="AdvancedTabs" SelectionChanged="AdvancedTabs_SelectionChanged">
                        <SelectorBarItem Text="Shift states" Tag="tab-shiftstates" IsSelected="True" />
                        <SelectorBarItem Text="Scan codes" Tag="tab-scancodes" />
                        <SelectorBarItem Text="Key names" Tag="tab-keynames" />
                        <SelectorBarItem Text="Ligatures" Tag="tab-ligatures" />
                    </SelectorBar>
                    </Grid>
                    <Grid x:Name="AdvancedPages" Grid.Row="1">
                    <Grid>
                        <Grid RowSpacing="12" Padding="0,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                Style="{StaticResource BodyTextBlockStyle}"
                                TextWrapping="Wrap"
                                Text="Each shift state is a column of characters. AltGr is Ctrl + Alt. Kana states need a key that sends KANA (set one on the Scan codes tab); Kana then works as a lock, like in Japanese layouts." />
                            <StackPanel Grid.Row="1" Spacing="8" Padding="12" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Layer keys" />
                                <TextBlock
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap"
                                    Text="A layer key works like an extra Shift: hold it and the keys type the layer's characters (Greek, symbols, IAST…). It is built into the layout, so it works in every app without extra software." />
                                <ItemsControl ItemsSource="{x:Bind ViewModel.ShiftStateEditor.LayerKeyRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:LayerKeyRowViewModel">
                                            <Grid Padding="0,4" ColumnSpacing="16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{x:Bind Description}" />
                                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Details}" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="Remove" Command="{x:Bind RemoveCommand}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <ComboBox
                                        MinWidth="260"
                                        DisplayMemberPath="Label"
                                        ItemsSource="{x:Bind ViewModel.ShiftStateEditor.LayerKeyOptions}"
                                        SelectedItem="{Binding ShiftStateEditor.SelectedLayerKeyOption, Mode=TwoWay}" />
                                    <ComboBox
                                        MinWidth="140"
                                        DisplayMemberPath="Label"
                                        ItemsSource="{x:Bind ViewModel.ShiftStateEditor.LayerOptions}"
                                        SelectedItem="{Binding ShiftStateEditor.SelectedLayer, Mode=TwoWay}" />
                                    <CheckBox Content="With Shift" IsChecked="{x:Bind ViewModel.ShiftStateEditor.LayerWithShift, Mode=TwoWay}" />
                                    <Button Content="Add layer key" Command="{x:Bind ViewModel.ShiftStateEditor.AddLayerKeyCommand}" />
                                </StackPanel>
                            </StackPanel>
                            <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.ShiftStateEditor.Columns}" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ShiftColumnViewModel">
                                        <Grid Padding="0,6" ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Name}" />
                                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                    <Run Text="{x:Bind Summary}" />
                                                    <Run Text=" " />
                                                    <Run Text="{x:Bind AlsoSelectedBy}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Remove" Command="{x:Bind RemoveCommand}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <StackPanel Grid.Row="3" Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <CheckBox Content="Shift" IsChecked="{x:Bind ViewModel.ShiftStateEditor.AddShift, Mode=TwoWay}" />
                                    <CheckBox Content="Ctrl" IsChecked="{x:Bind ViewModel.ShiftStateEditor.AddCtrl, Mode=TwoWay}" />
                                    <CheckBox Content="Alt" IsChecked="{x:Bind ViewModel.ShiftStateEditor.AddAlt, Mode=TwoWay}" />
                                    <CheckBox Content="Kana" IsChecked="{x:Bind ViewModel.ShiftStateEditor.AddKana, Mode=TwoWay}" />
                                    <Button Content="Add shift state" Command="{x:Bind ViewModel.ShiftStateEditor.AddCommand}" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.ShiftStateEditor.Message, Mode=OneWay}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                    <Grid Visibility="Collapsed">
                        <Grid RowSpacing="12" Padding="0,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                Style="{StaticResource BodyTextBlockStyle}"
                                TextWrapping="Wrap"
                                Text="Which physical key sends which virtual key. Change this to move keys around (e.g. swap Y and Z) or to turn a key into a modifier. Use names like OEM_8 or RMENU|EXT, or NONE." />
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                                <TextBox Width="220" PlaceholderText="Filter" Text="{x:Bind ViewModel.ScanCodes.Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Width="120" PlaceholderText="e.g. E0 5C" Text="{x:Bind ViewModel.ScanCodes.NewCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Content="Add scan code" Command="{x:Bind ViewModel.ScanCodes.AddCommand}" />
                                <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.ScanCodes.Message, Mode=OneWay}" />
                            </StackPanel>
                            <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.ScanCodes.Rows}" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ScanCodeRowViewModel">
                                        <StackPanel Orientation="Horizontal" Spacing="12" Padding="0,2">
                                            <TextBlock Width="56" VerticalAlignment="Center" FontFamily="Consolas" Text="{x:Bind Code}" />
                                            <TextBox Width="200" FontFamily="Consolas" Text="{x:Bind Target, Mode=TwoWay}" />
                                            <TextBlock Width="200" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind KeyName}" />
                                            <Button Command="{x:Bind RemoveCommand}" ToolTipService.ToolTip="Remove (E0 codes only)">
                                                <SymbolIcon Symbol="Delete" />
                                            </Button>
                                            <TextBlock VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Text="{x:Bind Error, Mode=OneWay}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Grid>
                    <Grid Visibility="Collapsed">
                        <Grid RowSpacing="12" Padding="0,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                Style="{StaticResource BodyTextBlockStyle}"
                                TextWrapping="Wrap"
                                Text="Names Windows shows for keys without characters, e.g. in shortcut settings and some games." />
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                                <TextBox Width="100" PlaceholderText="Scan code" Text="{x:Bind ViewModel.KeyNames.NewCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Width="200" PlaceholderText="Name" Text="{x:Bind ViewModel.KeyNames.NewName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Content="Add" Command="{x:Bind ViewModel.KeyNames.AddCommand}" />
                                <DropDownButton Content="Use standard names">
                                    <DropDownButton.Flyout>
                                        <MenuFlyout Placement="Bottom">
                                            <MenuFlyoutItem Text="English" Command="{x:Bind ViewModel.KeyNames.TranslateCommand}" CommandParameter="en" />
                                            <MenuFlyoutItem Text="German" Command="{x:Bind ViewModel.KeyNames.TranslateCommand}" CommandParameter="de" />
                                        </MenuFlyout>
                                    </DropDownButton.Flyout>
                                </DropDownButton>
                                <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.KeyNames.Message, Mode=OneWay}" />
                            </StackPanel>
                            <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.KeyNames.Rows}" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:KeyNameRowViewModel">
                                        <StackPanel Orientation="Horizontal" Spacing="12" Padding="0,2">
                                            <TextBlock Width="56" VerticalAlignment="Center" FontFamily="Consolas" Text="{x:Bind Code}" />
                                            <TextBox Width="260" Text="{x:Bind Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Command="{x:Bind RemoveCommand}" ToolTipService.ToolTip="Remove">
                                                <SymbolIcon Symbol="Delete" />
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Grid>
                    <Grid Visibility="Collapsed">
                        <Grid RowSpacing="12" Padding="0,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                Style="{StaticResource BodyTextBlockStyle}"
                                TextWrapping="Wrap"
                                Text="A ligature types several characters with one keystroke, e.g. a letter plus a combining mark (r + U+0323) or 'ng'. Up to 16 UTF-16 units; MSKLC only accepts 4." />
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                                <TextBox Width="120" PlaceholderText="Key, e.g. q" Text="{x:Bind ViewModel.Ligatures.NewKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <ComboBox MinWidth="180" DisplayMemberPath="Label" ItemsSource="{x:Bind ViewModel.ShiftStates}" SelectedItem="{Binding Ligatures.NewState, Mode=TwoWay}" PlaceholderText="Shift state" />
                                <TextBox Width="160" PlaceholderText="Text, e.g. ng" Text="{x:Bind ViewModel.Ligatures.NewText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Content="Add ligature" Command="{x:Bind ViewModel.Ligatures.AddCommand}" />
                                <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.Ligatures.Message, Mode=OneWay}" />
                            </StackPanel>
                            <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.Ligatures.Rows}" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LigatureRowViewModel">
                                        <StackPanel Orientation="Horizontal" Spacing="12" Padding="0,2">
                                            <TextBlock Width="80" VerticalAlignment="Center" Text="{x:Bind KeyName}" />
                                            <TextBlock Width="140" VerticalAlignment="Center" Text="{x:Bind StateName}" />
                                            <TextBox Width="160" FontSize="16" Text="{x:Bind Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Command="{x:Bind RemoveCommand}" ToolTipService.ToolTip="Remove">
                                                <SymbolIcon Symbol="Delete" />
                                            </Button>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind CodePoints, Mode=OneWay}" />
                                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemFillColorCautionBrush}" Text="{x:Bind Error, Mode=OneWay}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Grid>
                    </Grid>
                </Grid>
            </Grid>
            <Grid Visibility="Collapsed">
                <ScrollViewer>
                    <StackPanel MaxWidth="560" HorizontalAlignment="Left" Padding="0,8,0,24" Spacing="12">
                        <TextBox Header="Name" Text="{x:Bind ViewModel.LayoutName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Grid ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
    <TextBox Header="DLL name (1–8 letters or digits, e.g. kbdiast)" Text="{x:Bind ViewModel.DllName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <views:InfoButton Grid.Column="1" VerticalAlignment="Bottom" Topic="dll-name" />
                        </Grid>
                        <Grid ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
    <TextBox Header="Language (e.g. de-AT)" Text="{x:Bind ViewModel.Locale, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <views:InfoButton Grid.Column="1" VerticalAlignment="Bottom" Topic="language" />
                        </Grid>
                        <Grid ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
    <TextBox Header="Version" Text="{x:Bind ViewModel.LayoutVersion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <views:InfoButton Grid.Column="1" VerticalAlignment="Bottom" Topic="layout-version" />
                        </Grid>
                        <TextBox Header="Author" Text="{x:Bind ViewModel.Author, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Header="Description" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" Text="{x:Bind ViewModel.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Grid ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
    <CheckBox Content="Right Alt acts as AltGr" IsChecked="{x:Bind ViewModel.AltGrFlag, Mode=TwoWay}" />
                            <views:InfoButton Grid.Column="1" Topic="altgr" />
                        </Grid>
                        <Grid ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
    <ComboBox
                                Header="Shortcuts (Ctrl+C, Ctrl+V, Ctrl+Z …)"
                                HorizontalAlignment="Stretch"
                                DisplayMemberPath="Label"
                                ItemsSource="{x:Bind ViewModel.ShortcutModes}"
                                PlaceholderText="Mixed"
                                SelectedItem="{Binding SelectedShortcutMode, Mode=TwoWay}" />
                            <views:InfoButton Grid.Column="1" VerticalAlignment="Bottom" Topic="shortcuts" />
                        </Grid>
                        <TextBlock
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"
                            Text="{x:Bind ViewModel.ShortcutSummary, Mode=OneWay}" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                <Run Text="Layout ID: " />
                                <Run Text="{x:Bind ViewModel.LayoutId, Mode=OneWay, TargetNullValue='assigned on first install'}" />
                            </TextBlock>
                            <views:InfoButton Topic="layout-id" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            <Grid Visibility="Collapsed">
                <Grid RowSpacing="8" Padding="0,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.IssueSummary, Mode=OneWay}" />
                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Issues}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="val:ValidationIssue">
                                <Grid Padding="0,6" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        VerticalAlignment="Top"
                                        Glyph="{x:Bind local:Converters.SeverityGlyph(Severity)}"
                                        Foreground="{x:Bind local:Converters.SeverityBrush(Severity)}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{x:Bind Message}" TextWrapping="Wrap" />
                                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Code}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>
            </Grid>
        </Grid>

        <TextBlock
            Grid.Row="2"
            Style="{StaticResource CaptionTextBlockStyle}"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="{x:Bind ViewModel.Status, Mode=OneWay}"
            TextWrapping="Wrap" />
    </Grid>
</UserControl>
