<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Kbdking.App</RootNamespace>
    <AssemblyName>Kbdking.App</AssemblyName>
    <Description>kbdking: create, edit and install Windows keyboard layouts.</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\kbdking.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged app: no MSIX needed to run it; the Windows App SDK ships inside the app folder. -->
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Generates the resource index (.pri) that WinUI needs to find its styles and the compiled XAML,
         also for this unpackaged app; without it the app fails at startup with "XAML parsing failed". -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- XAML compiler warnings are not under our control; keep them visible but non-fatal. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.*" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- Window icon and the logo on the About page, loaded from the app folder. -->
    <Content Include="Assets\kbdking.ico;Assets\kbdking.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kbdking.Presentation\Kbdking.Presentation.csproj" />
  </ItemGroup>

</Project>
